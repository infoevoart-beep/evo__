# Copy to .env and adjust. Nothing here is secret today, but .env is
# gitignored so it stays safe when something is.

# ───────────────────────────── server ─────────────────────────────
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Serve the built front end from this process as well as the API.
# Set false to run the API alone behind a separate static host.
SERVE_CLIENT=true

# Where `npm run build` leaves the front end. Defaults to client/dist.
# CLIENT_DIR=/srv/hillsedge/client/dist

# Where bookings are appended, as JSON Lines.
# RESERVATIONS_FILE=/var/lib/hillsedge/reservations.jsonl

# Booking attempts allowed per address per window.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10

# Number of proxies in front of this process (nginx, Cloudflare, a platform
# router). Leave 0 if it is directly exposed: trusting a forwarded header
# nobody set lets a client spoof its address and evade the rate limiter.
TRUST_PROXY=0

# ───────────────────────────── client ─────────────────────────────
# Only needed if the front end is served from a different origin to the API.
# Left empty, the app calls /api on its own origin.
# VITE_API_BASE_URL=https://api.hillsedgeberagala.com

# Where `npm run dev` proxies /api during development.
# VITE_DEV_API_TARGET=http://localhost:4000
